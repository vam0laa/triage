# Maintainer: vam0laa <283932871+vam0laa@users.noreply.github.com>
pkgname=triage
pkgver=0.3.0
pkgrel=1
pkgdesc='Read-only health check for Arch Linux + Hyprland'
arch=('x86_64' 'aarch64')
url='https://github.com/vam0laa/triage'
license=('MIT')
makedepends=('go')
options=('!debug')
replaces=('vamola-doctor')
conflicts=('vamola-doctor')
optdepends=('smartmontools: disk SMART health module')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3a1284d67eac851284ae578050895839a37e7e480d2de63cd2d44beed984e4e5')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  go build -trimpath -mod=readonly -ldflags "-s -w" -o triage ./cmd/triage
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 triage "$pkgdir/usr/bin/triage"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
